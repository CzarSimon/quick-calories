# Public backend address (not a secret). Without this file the app uses production.
# Metro inlines it when bundling, so for a dev client it comes from the machine running `npm start`.
# Simulator against a local backend:
# EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
EXPO_PUBLIC_POCKETBASE_URL=https://quick-calories.pb.simonlilja.eu
