{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://quick-calories.pb.simonlilja.eu"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://quick-calories.pb.simonlilja.eu"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_POCKETBASE_URL": "https://quick-calories.pb.simonlilja.eu"
      }
    }
  }
}
